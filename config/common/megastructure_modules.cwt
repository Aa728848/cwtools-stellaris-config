
types = {
	type[megastructure_module] = {
		path = "game/common/megastructure_modules"
		localisation = {
			## required
			Name = "$"
			## required
			Description = "$_desc"
		}
	}
}

megastructure_module = {
	icon = <sprite>
	## cardinality = 0..1
	###Construction time in days
	construction_days = int
	## cardinality = 0..1
	is_unique = bool
	## cardinality = 0..1
	potential = {
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..1
	possible = {
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..1
	resources = {
		category = <economic_category>
		alias_name[economic_template] = alias_match_left[economic_template]
	}
	## cardinality = 0..1
	contributor_resources = {
		category = <economic_category>
		alias_name[economic_template] = alias_match_left[economic_template]
	}
	## cardinality = 0..inf
	alias_name[triggered_country_modifier_country] = alias_match_left[triggered_country_modifier_country]
	## cardinality = 0..1
	ai_weight = {
		alias_name[modifier_rule] = alias_match_left[modifier_rule]
	}
	## cardinality = 0..1
	modifier = {
		alias_name[modifier] = alias_match_left[modifier]
	}
	## cardinality = 0..1
	planet_modifier = {
		alias_name[modifier] = alias_match_left[modifier]
	}
	## cardinality = 0..1
	on_finished = {
		alias_name[effect] = alias_match_left[effect]
	}
	## cardinality = 0..1
	on_destroyed = {
		alias_name[effect] = alias_match_left[effect]
	}
}
