
types = {
	type[zones] = {
		path = "game/common/zones"
		modifiers = {
			"planet_$_build_speed_mult" = Planets
		}
	}
	type[zone_slots] = {
		path = "game/common/zone_slots"
	}	
}

zones = {
	## cardinality = 0..1
	icon = <sprite>
	## cardinality = 0..1
	base_buildtime = int
	## cardinality = 0..1
	max_buildings_planet_class = bool
	## cardinality = 0..1
	### Allow a modifier to dynamically cap the building limit (default no).
	is_capped_by_modifier = bool
	## cardinality = 0..1
	planet_limit = int
	## cardinality = 0..1
	swap_type = <district>
	## cardinality = 0..1
	swap_type_weight = int
	
	## cardinality = 0..1
	## replace_scope = { root = planet this = planet }
	potential = { 
		## cardinality = 0..inf
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..1
	## replace_scope = { root = country this = country }
	### Max number of this zone per empire (optional: default is no limit).
	empire_limit = {
		## cardinality = 0..1
		base = int
		alias_name[modifier_rule] = alias_match_left[modifier_rule]
	}
	## cardinality = 0..1
	## replace_scope = { root = planet this = planet }
	planet_limit = {
		## cardinality = 0..1
		base = int
		alias_name[modifier_rule] = alias_match_left[modifier_rule]
	}
	## cardinality = 0..1
	## replace_scope = { root = planet this = planet }
	unlock = { 
		## cardinality = 0..inf
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..1
	## replace_scope = { root = planet this = planet }
	### Zone is destroyed when this evaluates true.
	destroy_trigger = {
		## cardinality = 0..inf
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..1
	## replace_scope = { root = country this = country }
	show_tech_unlock_if = { 
		## cardinality = 0..inf
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..inf
	resources = {
		## cardinality = 0..1
		category = <economic_category>
		alias_name[economic_template] = alias_match_left[economic_template]
	}
	## cardinality = 0..1
	ai_resource_production = {
		## cardinality = 0..inf
   		<resource> = int
		## cardinality = 0..1
		trigger = {
			alias_name[trigger] = alias_match_left[trigger]
		}
	}
		
	## cardinality = 0..inf
	## replace_scope = { this = colony root = colony }
	district_planet_modifier = {
		alias_name[modifier] = alias_match_left[modifier]
	}

	## cardinality = 0..inf
	## replace_scope = { this = colony root = colony }
	planet_modifier = {
		alias_name[modifier] = alias_match_left[modifier]
	}

	## cardinality = 0..inf
	## replace_scope = { root = planet this = planet }
	country_modifier = {
		alias_name[modifier] = alias_match_left[modifier]
	}
	## cardinality = 0..inf
	## replace_scope = { root = planet this = planet }
	district_country_modifier = {
		alias_name[modifier] = alias_match_left[modifier]
	}

	## cardinality = 0..inf
	## replace_scope = { root = planet this = planet }
	desc = localisation
	## cardinality = 0..inf
	## replace_scope = { root = planet this = planet }
	desc = {
		## cardinality = 0..1
		trigger = {
			## cardinality = 0..inf
			alias_name[trigger] = alias_match_left[trigger]
		}
		text = localisation
	}
	## cardinality = 0..inf
	triggered_desc = {
		## cardinality = 0..1
		trigger = {
			## cardinality = 0..inf
			alias_name[trigger] = alias_match_left[trigger]
		}
		text = localisation
	}

	## cardinality = 0..1
	max_buildings = int

	## cardinality = 0..1
	districts_per_building = float
	
	## cardinality = 0..1
	zone_sets = {
		## cardinality = 0..inf
		enum[zone_set]
		## cardinality = 0..inf
		enum[zone_set_additional]
	}
	
	## cardinality = 0..1
	include = {
		## cardinality = 0..1
		all
		## cardinality = 0..inf
		<building>
	}

	## cardinality = 0..1
	exclude = {
		## cardinality = 0..1
		all
		## cardinality = 0..inf
		<building>
	}
	
	## cardinality = 0..inf
	## severity = warning
	included_building_sets = {
		## cardinality = 0..inf
		enum[building_sets]
	}
	
	## cardinality = 0..inf
	## severity = warning
	excluded_building_sets = {
		## cardinality = 0..inf
		enum[building_sets]
	}
	
	## cardinality = 0..inf
	convert_to = {
		## cardinality = 0..inf
		<zones>
		## cardinality = 0..inf
		enum[zone_type]
	}
	
	## cardinality = 0..1
	show_in_tech = <technology>
	
	# for inline scripts to remove errors
	## cardinality = 0..inf
	alias_name[triggered_district_modifier_planet] = alias_match_left[triggered_district_modifier_planet]
	
	# for inline scripts to remove errors
	## cardinality = 0..inf
	alias_name[triggered_planet_modifier_planet] = alias_match_left[triggered_planet_modifier_planet]	

	# for inline scripts to remove errors
	## cardinality = 0..inf
	alias_name[triggered_country_modifier_planet] = alias_match_left[triggered_country_modifier_planet]	

	# for inline scripts to remove errors
	## cardinality = 0..inf
	alias_name[triggered_district_country_modifier_planet] = alias_match_left[triggered_district_country_modifier_planet]	

	# for inline scripts to remove errors
	## cardinality = 0..inf
	alias_name[triggered_planet_pop_group_modifier_species] = alias_match_left[triggered_planet_pop_group_modifier_species]	

	# for inline scripts to remove errors
	## cardinality = 0..inf
	alias_name[triggered_planet_modifier_pop_group] = alias_match_left[triggered_planet_modifier_pop_group]	

	## cardinality = 0..1
	ai_priority = int
	## cardinality = 0..inf
	ai_weight_coefficient = float
	## cardinality = 0..1
	## replace_scope = { root = planet this = planet }
	### Additional additive AI weight with triggered conditions.
	additional_ai_weight = {
		alias_name[modifier_rule] = alias_match_left[modifier_rule]
	}
	## cardinality = 0..1
	### Whether AI estimates production assuming no unemployment (default yes).
	ai_estimate_without_unemployment = bool
	## cardinality = 0..1
	## replace_scope = { root = planet this = planet }
	### Effects fired when zone is built.
	on_built = {
		alias_name[effect] = alias_match_left[effect]
	}
	## cardinality = 0..1
	## replace_scope = { root = planet this = planet }
	### Effects fired when zone is queued. Has access to local_spent_<resource>.
	on_queued = {
		alias_name[effect] = alias_match_left[effect]
	}
	## cardinality = 0..1
	## replace_scope = { root = planet this = planet }
	### Effects fired when zone is removed from queue. Has access to local_spent_<resource>.
	on_unqueued = {
		alias_name[effect] = alias_match_left[effect]
	}
	## cardinality = 0..1
	included_buildings = {
		## cardinality = 0..inf
		all
		## cardinality = 0..inf
		<building>
	}
	## cardinality = 0..1
	### Explicit buildings excluded from this zone.
	excluded_buildings = {
		## cardinality = 0..inf
		all
		## cardinality = 0..inf
		<building>
	}
	## cardinality = 0..inf
	triggered_buildings = {
		trigger = {
			alias_name[trigger] = alias_match_left[trigger]
		}
		## cardinality = 0..1
		included_buildings = {
			## cardinality = 0..inf
			all
			## cardinality = 0..inf
			<building>
		}
		## cardinality = 0..1
		excluded_buildings = {
			## cardinality = 0..inf
			all
			## cardinality = 0..inf
			<building>
		}
		## cardinality = 0..inf
		included_building_sets = {
			## cardinality = 0..inf
			enum[building_sets]
		}
		## cardinality = 0..inf
		excluded_building_sets = {
			## cardinality = 0..inf
			enum[building_sets]
		}
	}
}

zone_slots = {

	## cardinality = 0..1
	start = <zones>
	## cardinality = 0..1
	start = enum[zone_type]
	
	## cardinality = 0..1
	included_zone_sets = {
		## cardinality = 0..inf
		enum[zone_set]
		## cardinality = 0..inf
		enum[zone_set_additional]
	}

	## cardinality = 0..1
	excluded_zone_sets = {
		## cardinality = 0..inf
		enum[zone_set]
		## cardinality = 0..inf
		enum[zone_set_additional]
	}

	## cardinality = 0..1
	include = {
		## cardinality = 0..inf
		<zones>
		## cardinality = 0..inf
		enum[zone_type]
	}

	## cardinality = 0..1
	exclude = {
		## cardinality = 0..inf
		<zones>
		## cardinality = 0..inf
		enum[zone_type]
	}

	## cardinality = 0..1
	## replace_scope = { root = planet this = planet from = planet }
    potential = { 
        alias_name[trigger] = alias_match_left[trigger]
    }

	## cardinality = 0..1
	## replace_scope = { root = planet this = planet from = planet }
	unlock = { 
		alias_name[trigger] = alias_match_left[trigger]
	}
}

enums = {
	enum[zone_type] = {
		all
		any
	}
	complex_enum[zone_set] = {
		path = "game/common/zones"
		name = {
			zone_sets = {
				enum_name
			}
		}
	}
	enum[zone_set_additional] = {
		zone_default
	}
}