	## cardinality = 0..1
	base = auto
	## cardinality = 0..1
	base = none
	## cardinality = 0..inf
	add_trait = <trait>
	## cardinality = 0..inf
	## push_scope = trait
	add_random_species_trait = {
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..1
	on_random_trait_added = {
		alias_name[effect] = alias_match_left[effect]
	}
	## cardinality = 0..1
	sapient = bool
	## cardinality = 0..1
	add_traits_at_start_of_list = bool
	## cardinality = 0..inf
	remove_trait = <trait>
	## cardinality = 0..1
	ideal_planet_class = scope_group[target_planet]
	## cardinality = 0..1
	ideal_planet_class = scope_group[target_species]
	## cardinality = 0..1
	ideal_planet_class = <planet_class>
	## cardinality = 0..1
	###modify scoped pops/planet/leader/country; default: yes
	change_scoped_species = bool
	## cardinality = 0..1
	portrait = scope_group[target_species]
	## cardinality = 0..1
	portrait = <portrait>
	## cardinality = 0..1
	portrait = <portrait_group>
	## cardinality = 0..1
	portrait = random
	## cardinality = 0..1
	inherit_parent_rights = bool
	## cardinality = 0..1
	## push_scope = species
	effect = {
		alias_name[effect] = alias_match_left[effect]
	}
}

