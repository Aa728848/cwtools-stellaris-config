###Change the scoped country's government authority and/or civics
## cost = o(n)
## engine = The command delegates to a helper that scans a container, so cost grows with the size of that container.
## engine_evidence = CGovernmentRestrictionsSolver::CalcRandomConfiguration (delegates to a helper that scans); dump L2906600
alias[effect:change_government] = random
alias[effect:change_government] = <authority>
alias[effect:change_government] = {
	## cardinality = 0..1
	authority = random
	## cardinality = 0..1
	authority = <authority>
	## cardinality = 0..1
	### random includes starting civics
	civics = random
	## cardinality = 0..1
	civics = {
		## cardinality = 1..4
		civic = <civic_or_origin.civic>
		## cardinality = 1..4
		civic = random
	}
	## cardinality = 0..1
	cooldown = bool
	## cardinality = 0..1
	remove_invalid_civics = bool
}

#ideally, "heir" should only be if type = ruler
###Kills the scoped leader or leader of the scoped country/fleet/ship/planet/army/first contact system/spy network
## cost = o(n)
## engine = The command's own implementation scans a container on the scoped object, so cost grows with how much that object holds.
## engine_evidence = CKillLeaderEffect::ExecuteActual (loop in the command implementation); dump L6452300
alias[effect:kill_leader] = {
	##cardinality = 0..1
	class = <leader_class>
	##cardinality = 0..1
	class = enum[leader_classes]
	##cardinality = 0..1
	class = enum[old_leader_classes]
	##cardinality = 0..1
	show_notification = bool
	##cardinality = 0..1
	ruler = bool
	##cardinality = 0..1
	heir = bool
	##cardinality = 0..1
	###default: no; if yes, fires on_leader_fired instead of on_leader_death
	fire = bool
	##cardinality = 0..1
	executed = bool
}

###Shifts an empire towards a specific ethic, adjusting aferwards to keep number of ethics points consistent
## cost = o(n)
## engine = The command delegates to a helper that scans a container, so cost grows with the size of that container.
## engine_evidence = CCountryEthos::ShiftTowardsEthic (delegates to a helper that scans); dump L2601940
alias[effect:shift_ethic] = <ethos>
###Adds a specific ethic to the scoped country
alias[effect:country_add_ethic] = <ethos>
###Adds a specific ethic to the scoped country
alias[effect:country_add_ethic] = random
###Removes a specific ethic from the scoped country
alias[effect:country_remove_ethic] = <ethos>
###Destroys the colony on the scoped planet
## cost = o(1)
## engine = No container scan was found in the command's implementation or in the helpers it calls directly; the work is a lookup or a fixed number of steps.
## engine_evidence = CDestroyColonyEffect::ExecuteActual (no scan in the command or its direct callees); dump L6409568
alias[effect:destroy_colony] = yes
#alias[effect:set_ruined] = bool
###Picks one random set of effects from a list, influenced by relative weight
alias[effect:random_list] = {
	##cardinality = 1..inf
	float = {
		##cardinality = 0..inf
		alias_name[modifier_rule] = alias_match_left[modifier_rule]
		##cardinality = 0..inf
		alias_name[effect] = alias_match_left[effect]
	}
}

###Picks one random set of effects from a list, influenced by relative weight once per event scope. Works like a random list, but the tooltip will only show the option that actually happens.
## cost = o(n)
## engine = The command delegates to a helper that scans a container, so cost grows with the size of that container.
## engine_evidence = CLockedRandomListEffect::GetOptionIndex (delegates to a helper that scans); dump L6651092
alias[effect:locked_random_list] = {
	##cardinality = 1..inf
	float = {
		##cardinality = 0..inf
		alias_name[modifier_rule] = alias_match_left[modifier_rule]
		##cardinality = 0..inf
		alias_name[effect] = alias_match_left[effect]
	}
}

###All enclosed effects may or may not be executed depending on set chance
alias[effect:random] = {
	chance = int_value_field[1..99]
	alias_name[effect] = alias_match_left[effect]
}

###Creates a new fleet from empire designs up to specified fraction of naval cap
alias[effect:create_fleet_from_naval_cap] = value_field
###Creates a new fleet from empire designs up to specified fraction of naval cap
alias[effect:create_fleet_from_naval_cap] = {
	fraction = value_field
	ship_owner_type = country
	ship_owner_type = federation
	ship_owner_type = galactic_community
	##cardinality = 0..inf
	can_overflow = bool
}

###Reduces the hull points of the scoped ship by a specific amount
alias[effect:reduce_hp] = int_value_field
###Reduces the hull points of the scoped ship by a relative amount
# alias[effect:reduce_hp_percent] = value_field[0.0..1.0]
###Reduces the hull points of the scoped ship by a relative amount
alias[effect:reduce_hp_percent] = int_value_field[0..100]
