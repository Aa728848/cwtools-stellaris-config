### Spawns a new system at a position relative to the scoped system/planet/ship.
## cost = o(n^2)
## engine = The command delegates to a helper that scans a container, so cost grows with the size of that container. Rebuilds the O(N^2) galactic distance cache per call unless wrapped in a spawn-system batch block.
## engine_evidence = CSystemInitializerUseCounter::HasReachedMaxUses (delegates to a helper that scans); dump L1203448
alias[effect:spawn_system] = {
	## cardinality = 0..1
	min_distance = float
	## cardinality = 0..1
	max_distance = float
	## cardinality = 0..1
	min_distance = value_field
	## cardinality = 0..1
	max_distance = value_field
	## cardinality = 0..1
	min_jumps = int[0..1000]
	## cardinality = 0..1
	max_jumps = int[0..1000]
	## cardinality = 0..1
	initializer = <solar_system_initializer>
	initializer = random
	## cardinality = 0..1
	initializer = random
	## cardinality = 0..1
	hyperlane = bool
	## cardinality = 0..1
	is_discovered = bool
	## cardinality = 0..1
	min_orientation_angle = float
	## cardinality = 0..1
	max_orientation_angle = float
	## cardinality = 0..1
	direction = corewards
	## cardinality = 0..1
	direction = rimwards
	## cardinality = 0..1
	direction = right
	## cardinality = 0..1
	direction = left
	## cardinality = 0..1
	authorize_spawn_on_galactic_core = bool
	## cardinality = 0..1
	## push_scope = system
	effect = {
		alias_name[effect] = alias_match_left[effect]
	}
}

