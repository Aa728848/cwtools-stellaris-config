###Adds a specific modifier to the scoped planet/pop/country/fleet/ship/pop/system/faction for a set duration
## cost = o(n)
## engine = The command's own implementation scans a container on the scoped object, so cost grows with how much that object holds.
## engine_evidence = CAddModifierEffect::ExecuteActual (loop in the command implementation); dump L6631111
alias[effect:add_modifier] = {
	modifier = <static_modifier>
	# severity = info
	## cardinality = 0..1
	enum[days_months_years] = float
	## cardinality = 0..inf
	mult = value[variable]
	## cardinality = 0..inf
	mult = value_field
	## cardinality = 0..inf
	mult = trigger:<trigger>
    ## cardinality = 0..inf
	mult = enum[exe_set_variable]
	## cardinality = 0..inf
	multiplier = value[variable]
	## cardinality = 0..inf
	multiplier = value_field
	## cardinality = 0..inf
	multiplier = trigger:<trigger>
    ## cardinality = 0..inf
	multiplier = enum[exe_set_variable]
	## cardinality = 0..1
	time_multiplier = value_field
	## cardinality = 0..1
	clear_on_owner_change = bool
}

###Displays a custom text (localisation string)
alias[effect:custom_tooltip] = localisation
###Adds a specific opinion modifier for the scoped country towards target country
## cost = o(1)
## engine = No container scan was found in the command's implementation or in the helpers it calls directly; the work is a lookup or a fixed number of steps. Non-accumulative/unique uses append a new record every call and never deduplicate.
## engine_evidence = CAddOpinionModifierEffect::ExecuteActual (no scan in the command or its direct callees); dump L6441991
alias[effect:add_opinion_modifier] = {
	who = scope_group[target_country]
	modifier = <opinion_modifier>
}

###Removes a specific opinion modifier towards target country or any country from the scoped country
## cost = o(1)
## engine = No container scan was found in the command's implementation or in the helpers it calls directly; the work is a lookup or a fixed number of steps.
## engine_evidence = CRemoveOpinionModifierEffect::ExecuteActual (no scan in the command or its direct callees); dump L6442829
alias[effect:remove_opinion_modifier] = {
	who = scope_group[target_country]
	modifier = <opinion_modifier>
}

###Removes a specific modifier from the scopes planet/country/pop/system
## cost = o(n)
## engine = The command's own implementation scans a container on the scoped object, so cost grows with how much that object holds.
## engine_evidence = CRemoveModifierEffect::ExecuteActual (loop in the command implementation); dump L6631852
alias[effect:remove_modifier] = <static_modifier>
#flags
###Sets an arbitrarily-named flag on the scoped pop group for a set duration
## cost = o(n)
## engine = The command delegates to a helper that scans a container, so cost grows with the size of that container.
## engine_evidence = CPdxIntegerFlags::ClearFlag (delegates to a helper that scans); dump L7633282
alias[effect:set_timed_pop_group_flag] = {
	flag = value_set[pop_group_flag]
	## cardinality = 0..1
	days = int
	## cardinality = 0..1
	days = value_set[variable]
	## cardinality = 0..1
	months = int
	## cardinality = 0..1
	months = value_set[variable]
	## cardinality = 0..1
	years = int
	## cardinality = 0..1
	years = value_set[variable]
}

###Sets an arbitrarily-named flag on the scoped country
## cost = o(n)
## engine = Flag stores are plain arrays on the scope and every flag operation walks them, so cost grows with how many flags the object already carries. One shared implementation serves every flag domain (country, ship, planet, star, ...); the scope type only selects which array the virtual call returns. The name-to-id lookup itself is a hash, so the scan is what costs.
## engine_evidence = CPdxIntegerFlags::ClearFlag (delegates to a helper that scans); dump L7633282
alias[effect:set_country_flag] = value_set[country_flag]
###Sets an arbitrarily-named flag on the scoped planet. Also valid in colony/carrier/ship scope, where it writes the colony carrier's flags
