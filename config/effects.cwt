## cost = o(n)
## engine = The command's own implementation scans a container on the scoped object, so cost grows with how much that object holds.
## engine_evidence = CCreateMessageEffect::ExecuteActual (loop in the command implementation); dump L6503030
alias[effect:create_message] = {
	type = <message_type>
	## cardinality = 0..1
	localization = localisation
	## cardinality = 0..1
	days = int	#no variables here atm
	## cardinality = 0..1
	### Default = this
	target = scope[any]
	## cardinality = 0..1
	custom_message_text = localisation
	## cardinality = 0..1
	custom_toast_icon = <sprite>
	## cardinality = 0..1
	custom_toast_content_icon = <sprite>
	# note: the variable sections were combined as cwtools could not handle them separated in biogenesis_origin_events.txt
	## cardinality = 0..inf
	variable = {
		## cardinality = 0..1
		type = name
		## cardinality = 0..1
		type = variable
		## cardinality = 0..1
		type = key
		## cardinality = 0..1
		localization = scalar
		## cardinality = 0..1
		scope = scope[any]
		## cardinality = 0..1
		scope = species
		## cardinality = 0..1
		varname = value[variable]
		## cardinality = 0..1
		varname = this.trophy_hunter_gained_<resource>
		## cardinality = 0..1
		varname = enum[varname_enum]
		## cardinality = 0..1
		value = localisation
		## cardinality = 0..1
		value = <trait>
		## cardinality = 0..1
		value = <sprite>
		## cardinality = 0..1
		key = TRAIT_KEY
		## cardinality = 0..1
		key = border
		## cardinality = 0..1
		trigger = {
			alias_name[trigger] = alias_match_left[trigger]
		}
	}
	## cardinality = 0..1
	recipient = scope[country]
}

#
### Creates a military fleet with the designs of a specified country.
## cost = o(n^2)
## engine = The command's own implementation contains nested loops over the scoped container, so cost grows quadratically.
## engine_evidence = CCreateMilitaryFleetEffect::ExecuteActual (nested loop in the command implementation); dump L6490869
alias[effect:create_military_fleet] = {
	owner = scope_group[target_country]
	scaled_size = {
		alias_name[modifier_rule] = alias_match_left[modifier_rule]
	}
	effect = {
		alias_name[effect] = alias_match_left[effect]
	}
}

### Creates a mining station in orbit of the scoped planet
alias[effect:create_mining_station] = {
	owner = scope_group[target_country]
	## cardinality = 0..1
	## push_scope = ship
	effect = {
		alias_name[effect] = alias_match_left[effect]
	}
}

### Creates a point of interest for the scoped country at a specific location, associated with an event chain
## cost = o(1)
## engine = No container scan was found in the command's implementation or in the helpers it calls directly; the work is a lookup or a fixed number of steps.
## engine_evidence = CCreatePointOfInterestEffect::ExecuteActual (no scan in the command or its direct callees)
alias[effect:create_point_of_interest] = {
	id = value_set[point_of_interest]
	## cardinality = 1..1
	## severity = info
	###Leaving out "name" gives a blank button that looks really terrible and unprofessional. Don't do it :P
	name = localisation
	#The last comment does not apply here.
	## cardinality = 0..1
	desc = localisation
	## cardinality = 0..1
	event_chain = <event_chain>
	## cardinality = 0..1
	location = scope_group[spatial_object]
	## cardinality = 0..1
	location = scope_group[celestial_coordinate]
	## cardinality = 0..1
	location = scope[system]
	## cardinality = 0..1
	location = scope[country]
	## cardinality = 0..1
	location = scope[pop]
	## cardinality = 0..1
	location = scope[leader]
	## cardinality = 0..1
	location = scope[deposit]
	## cardinality = 0..1
	location = scope[army]
	## cardinality = 0..1
	category = scalar
	## cardinality = 0..1
	picture = <sprite>
}

### Creates a research station in orbit of the scoped planet
alias[effect:create_research_station] = {
	owner = scope_group[target_country]
	## cardinality = 0..1
	## push_scope = ship
	effect = {
		alias_name[effect] = alias_match_left[effect]
	}
}

### Creates a new saved leader for the scoped country with a lookup key
## cost = o(n)
## engine = The command's own implementation scans a container on the scoped object, so cost grows with how much that object holds.
## engine_evidence = CCreateSavedLeaderEffect::ExecuteActual (loop in the command implementation); dump L6546403
alias[effect:create_saved_leader] = {
	###Referral key from localisation etc. Can also be used as right-hand argument in picture_event_data = { portrait = <key> }
	key = value_set[saved_leader]
	## cardinality = 0..1
	###Used for generation of the leader, defaut is same as country in scope.
	creator = scope_group[target_country]
	## cardinality = 0..1
	name = random
	alias_name[name] = alias_match_left[name]
	## cardinality = 0..1
	gender = enum[genders]
	## cardinality = 0..1
	class = random
	## cardinality = 0..1
	class = <leader_class>
	## cardinality = 0..1
	class = enum[leader_classes]
	## cardinality = 0..1
	species = scope_group[target_species]
	##cardinality = 0..1
	class = enum[old_leader_classes]
	## cardinality = 0..1
	immortal = bool
	## cardinality = 0..1
	tier = <leader_tiers>
	## cardinality = 0..1
	event_leader = bool
	## cardinality = 0..1
	set_age = int
	## cardinality = 0..1
	skill = random
	## cardinality = 0..1
	skill = int
	## cardinality = 0..1
	###Default = no
	hide_age = bool
	## cardinality = 0..inf
	background_ethic = <ethos>
	## cardinality = 0..inf
	background_ethic = random
	## cardinality = 0..1
	###Default = no
	skip_background_generation = bool
	## cardinality = 0..1
	custom_description = localisation
	## cardinality = 0..1
	custom_catch_phrase = localisation
	## cardinality = 0..1
	###Default = yes
	randomize_traits = bool
	## cardinality = 0..1
	###Default = yes
	can_manually_change_location = bool
	## cardinality = 0..1
	###Default = yes
	can_see_in_list = bool
	## cardinality = 0..1
	###Default = yes
	can_assign_to_council = bool
	## cardinality = 0..1
	traits = {
		## cardinality = 0..5
		add_trait = <trait.leader_trait>
		## cardinality = 0..5
		add_trait = random_trait
		## cardinality = 0..5
		trait = <trait.leader_trait>
		## cardinality = 0..5
		trait = random_trait
		## cardinality = 0..inf
		int = <trait.leader_trait>
	}
	## push_scope = leader
	## cardinality = 0..1
	effect = {
		alias_name[effect] = alias_match_left[effect]
	}
}

### Creates a new ship
## cost = o(n)
## engine = The command's own implementation scans a container on the scoped object, so cost grows with how much that object holds.
## engine_evidence = CCreateShipEffect::ExecuteActual (loop in the command implementation); dump L6379751
alias[effect:create_ship] = {
	## cardinality = 0..1
	name = random
	alias_name[name] = alias_match_left[name]
	## cardinality = 0..1
	fleet_cache_recalc = bool
	## cardinality = 0..1
	name = scope[ship]
	## cardinality = 0..1
	design = last_created_design
	## cardinality = 0..1
	design = <global_ship_design>
	## cardinality = 0..1
	design = scope[ship]
	## cardinality = 0..1
	create_colony = bool
	## cardinality = 0..1
	design = scope[design]
	## severity = warning
	## cardinality = 0..1
	# Hack to handle named designs
	design = localisation
	## cardinality = 0..1
	random_existing_design = <ship_size>
	## cardinality = 0..1
	prefix = bool
	## cardinality = 0..1
	suffix = bool
	## cardinality = 0..1
	graphical_culture = <graphical_culture>
	## cardinality = 0..1
	graphical_culture = scope_group[target_country]
	## cardinality = 0..1
	graphical_culture_fallback = <graphical_culture>
	## cardinality = 0..1
	graphical_culture_fallback = scope_group[target_country]
	## cardinality = 0..1
	upgradable = bool
	## cardinality = 0..1
	###Used if the created ship is a colony ship
	colonizer_species = scope_group[target_species]
	## cardinality = 0..1
	age = int
	## cardinality = 0..1
	rarity = enum[rarity]
	## cardinality = 0..1
	growth_stage = int
	## cardinality = 0..1
	fleet_cache_recalc = bool
	## cardinality = 0..1
	## push_scope = ship
	effect = {
		alias_name[effect] = alias_match_left[effect]
	}
}

