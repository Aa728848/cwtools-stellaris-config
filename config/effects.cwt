#scripted effects
alias[effect:<scripted_effect>] = yes
###The scripted effect will draw the value of the right clause via $left_clause$.
alias[effect:<scripted_effect>] = {
	## cardinality = 1..inf
	enum[scripted_effect_params] = scalar
	## cardinality = 1..inf
	enum[scripted_effect_params] = scope_field
}

###Creates a starbase in orbit of the star of the scoped galactic object
## cost = o(n)
## engine = The command delegates to a helper that scans a container, so cost grows with the size of that container.
## engine_evidence = CShipDesignManager::GetOrCreateGlobalShipDesign (delegates to a helper that scans); dump L1331024
alias[effect:create_starbase] = {
	## cardinality = 0..1
	owner = scope_group[target_country]
	## cardinality = 1..1
	size = <ship_size.starbase>
	## cardinality = 0..1
	design = <global_ship_design>
	## cardinality = 0..100
	module = <starbase_module>
	## cardinality = 0..100
	building = <starbase_building>
	## cardinality = 0..1
	## push_scope = starbase
	effect = {
		alias_name[effect] = alias_match_left[effect]
	}
}

###Hides the enclosed effects from any generated tooltips
alias[effect:hidden_effect] = {
	alias_name[effect] = alias_match_left[effect]
}

###Executes enclosed effects if limit criteria are met
alias[effect:if] = {
	## cardinality = 0..inf
	limit = {
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..inf
	alias_name[effect] = alias_match_left[effect]
}

###Executes enclosed effects if limit criteria of both it and preceding 'if' or 'else_if' is not met, and its own limit is met
alias[effect:else_if] = {
	## cardinality = 0..inf
	limit = {
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..inf
	alias_name[effect] = alias_match_left[effect]
}

###Executes enclosed effects if limit criteria of preceding 'if' or 'else_if' is not met
alias[effect:else] = {
	## cardinality = 0..inf
	limit = {
		alias_name[trigger] = alias_match_left[trigger]
	}
	## cardinality = 0..inf
	alias_name[effect] = alias_match_left[effect]
}

###Saves the current scope as an arbitrarily-named target to be referenced later in the (unbroken) event chain
## cost = o(n)
## engine = The command delegates to a helper that scans a container, so cost grows with the size of that container.
## engine_evidence = CEventScope::SaveEventTarget (delegates to a helper that scans); dump L2666127
alias[effect:save_event_target_as] = value_set[event_target]
###Saves the current scope as an arbitrarily-named target to be referenced later, accessible globally until cleared
## cost = o(log n)
## engine = Global event targets are held in a sorted target array, so save/erase is logarithmic rather than a linear scan. Ordinary (non-global) event targets stay linear.
## engine_evidence = sorted CSavedEventTarget array with std::stable_sort; dump L408696 / L589775
alias[effect:save_global_event_target_as] = value_set[global_event_target]
###Fires a ship event for the scoped ship, with optional DAYS and RANDOM delay
alias[effect:ship_event] = {
	id = <event.ship>
	id = <event.carrier>
	id = <event.scopeless>
	## cardinality = 0..1
	days = int
	## cardinality = 0..1
	days = value_field
	## cardinality = 0..1
	months = int
	## cardinality = 0..1
	months = value_field
	## cardinality = 0..1
	years = int
	## cardinality = 0..1
	years = value_field
	## cardinality = 0..1
	random = int
	## cardinality = 0..1
	random = value_field
	## cardinality = 0..1
	scopes = {
		## cardinality = 0..1
		from = scope[any]
		## cardinality = 0..1
		fromfrom = scope[any]
		## cardinality = 0..1
		fromfromfrom = scope[any]
		## cardinality = 0..1
		fromfromfromfrom = scope[any]
	}
}

