#variables
###Sets or creates an arbitrarily-named variable with a specific value in the current scope
## cost = o(1)
## engine = Variables live in a per-scope hash map, so set/change/check are single lookups regardless of how many variables exist.
## engine_evidence = CSetVariableEffect::ExecuteActual (no scan in the command or its direct callees); dump L6572726
alias[effect:set_variable] = {
	which = value_set[variable]
	## cardinality = 0..1
	value = value_field
	## cardinality = 0..1
	value = enum[exe_set_variable]
}

#presumably need to check the variable exists first for these, somehow
###Increments a previously-set variable by a specific amount
## cost = o(1)
## engine = No container scan was found in the command's implementation or in the helpers it calls directly; the work is a lookup or a fixed number of steps.
## engine_evidence = CChangeVariableEffect::ExecuteActual (no scan in the command or its direct callees); dump L6573247
alias[effect:change_variable] = {
	which = value_set[variable]	#do not change to `value[variable]`, it does not need to be set for this
	## cardinality = 0..1
	value = value_field
	## cardinality = 0..1
	value = enum[exe_set_variable]
}

