### Optimizes the calls for spawn_system effect. Spawn system should be located in a block between Begin and End.
###Begin: set_spawn_system_batch = begin
###End: set_spawn_system_batch = end
## cost = o(n)
## engine = The command delegates to a helper that scans a container, so cost grows with the size of that container.
## engine_evidence = CGameState::GenerateGalacticMap (delegates to a helper that scans); dump L429013
alias[effect:set_spawn_system_batch] = enum[optimisation_batch]
###Disables modifier system to do full updates between Begin and End.
## cost = refresh_batch
## engine = Between begin and end the engine skips the full modifier update that adding a modifier would otherwise trigger; end performs one full update of the dirty modifiers. A missing begin/end or a wrong identifier is a script error.
## engine_evidence = CSetUpdateModifiersBatch::Assign; dump L6160984 (diagnostics L6161007/L6161023/L6161068)
alias[effect:set_update_modifiers_batch] = enum[optimisation_batch]
enums = {
	enum[optimisation_batch] = {
		begin
		end
	}
}

